{
  "name": "dropship-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:init": "wrangler d1 execute dropship-hub --remote --file=worker/schema.sql --config worker/wrangler.toml",
    "api:dev": "wrangler dev --config worker/wrangler.toml",
    "deploy:api": "wrangler deploy --config worker/wrangler.toml",
    "deploy:web": "wrangler pages deploy dist --project-name dropship-hub --branch main"
  },
  "dependencies": {
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "description": "Opsdeck: self-hosted dropshipping operations dashboard (React + Cloudflare Worker + D1)"
}
